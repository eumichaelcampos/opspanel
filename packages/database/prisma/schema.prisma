generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  owner
  admin
  operator
  developer
  viewer
}

enum LicenseStatus {
  active
  grace
  expired
  suspended
}

enum JobStatus {
  queued
  validating
  running
  verifying
  succeeded
  failed
  cancelled
  timed_out
}

enum ServerStatus {
  pending
  connecting
  healthy
  warning
  critical
  offline
  incompatible
  revoked
}

enum CredentialType {
  ssh_private_key
  ssh_password
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  memberships OrganizationMember[]
  sessions    Session[]
  jobs        Job[]                @relation("JobRequestedBy")
  auditLogs   AuditLog[]
  apiKeys     ApiKey[]
  updateDismissals UserUpdateDismissal[]
  secrets    UserSecret[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
}

enum UserSecretKind {
  openai_api_key
  openai_codex_oauth
  cloudflare_credentials
  google_drive
}

enum BackupContents {
  files_and_database
  files_only
  database_only
}

enum BackupSchedule {
  off
  daily
  every_12h
  weekly
}

enum EmailDomainStatus {
  draft
  pending_dns
  active
  error
}

enum EmailProviderKind {
  atriomail
  resend
}

enum AlertChannelType {
  slack
  webhook
  email
}

model UserSecret {
  id         String         @id @default(uuid())
  userId     String
  kind       UserSecretKind
  label      String?
  hint       String?
  ciphertext String
  iv         String
  authTag    String
  keyVersion Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

enum SiteStatus {
  unknown
  active
  disabled
  provisioning
  failed
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  members OrganizationMember[]
  servers Server[]
  sites   Site[]
  jobs    Job[]
  auditLogs AuditLog[]
  apiKeys ApiKey[]
  emailDomains EmailDomain[]
  alertChannels AlertChannel[]
  alertEvents AlertEvent[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(viewer)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Server {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  host           String
  port           Int          @default(22)
  status         ServerStatus @default(pending)
  lastConnectedAt DateTime?
  osRelease      String?
  wordopsVersion String?
  tags           String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential   ServerCredential?
  jobs         Job[]
  sites        Site[]
  lastSyncedAt DateTime?
  healthSnapshot Json?
  healthObservedAt DateTime?
  metricsSnapshot Json?
  metricsObservedAt DateTime?
  securitySnapshot Json?
  securityObservedAt DateTime?
  onboardingSnapshot Json?
  onboardingCompletedAt DateTime?
  wordopsDashboard Json?
}

model Site {
  id             String     @id @default(uuid())
  organizationId String
  serverId       String
  domain         String
  siteType       String?
  phpVersion     String?
  cacheBackend   String?
  status         SiteStatus @default(unknown)
  isEnabled      Boolean?
  infoSnapshot   Json?
  lastObservedAt DateTime?
  wpInventorySnapshot Json?
  wpInventoryObservedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  ftpUsers     SiteFtpUser[]
  backupPolicy SiteBackupPolicy?
  emailDomain  EmailDomain?
  smtpProfile  EmailSmtpProfile?

  @@unique([organizationId, domain])
  @@index([serverId])
}

model SiteBackupPolicy {
  id             String          @id @default(uuid())
  siteId         String          @unique
  contents       BackupContents  @default(files_and_database)
  keepLocal      Int             @default(7)
  schedule       BackupSchedule  @default(off)
  scheduleHour   Int             @default(3)
  uploadToDrive  Boolean         @default(false)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
}

model SiteFtpUser {
  id          String   @id @default(uuid())
  siteId      String
  username    String
  homePath    String
  passwordEnc Json?
  createdAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, username])
  @@index([siteId])
}

model EmailDomain {
  id               String            @id @default(uuid())
  organizationId   String
  siteId           String?           @unique
  domain           String
  provider         EmailProviderKind @default(atriomail)
  providerDomainId String?
  status           EmailDomainStatus @default(draft)
  webmailUrl       String?
  dnsBundle        Json?
  lastHealthAt     DateTime?
  healthSnapshot   Json?
  errorMessage     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  mailboxes    EmailMailbox[]
  smtpProfiles EmailSmtpProfile[]

  @@unique([organizationId, domain])
  @@index([organizationId])
}

model EmailMailbox {
  id                String   @id @default(uuid())
  emailDomainId     String
  localPart         String
  displayName       String?
  providerMailboxId String?
  quotaMb           Int      @default(10240)
  status            String   @default("active")
  imapHost          String?
  smtpHost          String?
  webmailUrl        String?
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  emailDomain EmailDomain @relation(fields: [emailDomainId], references: [id], onDelete: Cascade)

  @@unique([emailDomainId, localPart])
  @@index([emailDomainId])
}

model EmailSmtpProfile {
  id            String            @id @default(uuid())
  siteId        String            @unique
  emailDomainId String?
  provider      EmailProviderKind @default(resend)
  fromAddress   String
  fromName      String?
  providerRef   String?
  wpConfigured  Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  emailDomain EmailDomain? @relation(fields: [emailDomainId], references: [id], onDelete: SetNull)
}

model ServerCredential {
  id          String         @id @default(uuid())
  serverId    String         @unique
  type        CredentialType
  username    String
  ciphertext  String
  iv          String
  authTag     String
  keyVersion  Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model Job {
  id              String    @id @default(uuid())
  organizationId  String
  requestedById   String
  serverId        String?
  operationKey    String
  status          JobStatus @default(queued)
  progress        Int       @default(0)
  currentStep     String?
  idempotencyKey  String?
  inputJson       Json?
  resultJson      Json?
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("JobRequestedBy", fields: [requestedById], references: [id])
  server       Server?      @relation(fields: [serverId], references: [id])
  events       JobEvent[]

  @@index([organizationId, status])
  @@index([idempotencyKey])
}

model JobEvent {
  id        String   @id @default(uuid())
  jobId     String
  sequence  Int
  type      String
  message   String
  progress  Int?
  metadata  Json?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  result         String
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  createdById    String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model LicenseState {
  id             String        @id @default("default")
  instanceId     String        @unique
  licenseKeyHash String?
  plan           String
  status         LicenseStatus @default(active)
  entitlements   Json
  validUntil     DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model UsageCounter {
  id     String @id @default(uuid())
  metric String
  period String
  count  Int    @default(0)

  @@unique([metric, period])
  @@index([period])
}

model SystemUpdateState {
  id               String    @id @default("default")
  currentVersion   String
  latestVersion    String?
  latestChangelog  String?
  latestReleaseUrl String?
  updateAvailable  Boolean   @default(false)
  lastCheckedAt    DateTime?
  applyStatus      String    @default("idle")
  applyLog         String?
  applyStartedAt   DateTime?
  applyFinishedAt  DateTime?
  updatedAt        DateTime  @updatedAt
}

model AlertChannel {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  type           AlertChannelType
  webhookUrl     String?
  emailTo        String?
  enabled        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       AlertEvent[]

  @@index([organizationId])
}

model AlertEvent {
  id             String   @id @default(uuid())
  organizationId String
  channelId      String?
  kind           String
  title          String
  body           String?
  payload        Json?
  status         String
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      AlertChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([channelId])
}

model SystemSetupState {
  id          String    @id @default("default")
  completed   Boolean   @default(false)
  completedAt DateTime?
  /** Domínio público do painel, ex: painel.empresa.com */
  panelDomain String?
  /** URL canônica, ex: https://painel.empresa.com */
  panelUrl    String?
  googleDriveClientId String?
  googleDriveClientSecretCipher String?
  googleDriveClientSecretIv     String?
  googleDriveClientSecretAuthTag String?
  updatedAt   DateTime  @updatedAt
}

model UserUpdateDismissal {
  id          String   @id @default(uuid())
  userId      String
  version     String
  dismissedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId])
}
