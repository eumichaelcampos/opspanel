# Database
DATABASE_URL=postgresql://opspanel:opspanel@localhost:5432/opspanel

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# Secrets — REQUIRED: generate unique values before production
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-session-secret-min-32-chars!!
CREDENTIALS_ENCRYPTION_KEY=change-me-base64-32-bytes-key-here=

# Seed admin (change before production; skipped if SKIP_SEED=1)
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional: OpenAI for assistant (rule-based works without this)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
