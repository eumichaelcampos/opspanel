# Database
DATABASE_URL=postgresql://opspanel:opspanel@localhost:5432/opspanel

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# Secrets — REQUIRED: generate unique values before production
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-session-secret-min-32-chars!!
CREDENTIALS_ENCRYPTION_KEY=change-me-base64-32-bytes-key-here=

# Seed admin (change before production; skipped if SKIP_SEED=1)
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=ChangeMe123!

# Google Drive: cada instalação conecta a conta do usuário via Publisher
# (https://publisher.michaelcampos.com.br). Não precisa de app Google local.
# URI cadastrada no Google Cloud:
#   https://publisher.michaelcampos.com.br/v1/oauth/google/callback
# GOOGLE_OAUTH_BROKER_URL=https://publisher.michaelcampos.com.br/v1
#
# Só use as linhas abaixo se esta instalação for o hub OAuth (não o caso normal):
# GOOGLE_OAUTH_BROKER_ENABLED=true
# GOOGLE_OAUTH_BROKER_PUBLIC_URL=https://publisher.michaelcampos.com.br
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=


# E-mail externo (Atriomail caixas + Resend envio transacional WP)
# Credenciais da conta revenda na instância OpsPanel (não por site).
EMAIL_PROVIDER=atriomail
ATRIOMAIL_API_URL=https://api.atriomail.com
ATRIOMAIL_API_KEY=
ATRIOMAIL_MX_HOST=mail.atriomail.com
ATRIOMAIL_SPF_INCLUDE=spf.atriomail.com
RESEND_API_KEY=
EMAIL_WEBMAIL_BASE_URL=https://webmail.atriomail.com


# License (configured by first-run setup in the panel; required in production)
# LICENSE_KEY=oplic_...

# App version & updates (shown in UI; bump on each release)
APP_VERSION=1.0.0
UPDATE_GITHUB_REPO=eumichaelcampos/opspanel
